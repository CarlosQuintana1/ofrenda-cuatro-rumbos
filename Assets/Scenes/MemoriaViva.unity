  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MemoriaViva.WorldInteractable
  action: 1
  title: Ramos de flores
  description: "Las flores son s\xEDmbolo de la festividad. El cempas\xFAchil gu\xEDa
    a las \xE1nimas con su color, que representa al sol. La flor de nube y el alhel\xED
    significan pureza y ternura y acompa\xF1an a las \xE1nimas de los ni\xF1os. El
    terciopelo, de color morado rojizo, es otra flor tradicional de la temporada.
    (Fuente: INPI y Profeco, gob.mx)"
  verb: 
  offeringIndex: -1
  destination: {x: 0, y: 0, z: 0}
  activeVisual: {fileID: 0}
