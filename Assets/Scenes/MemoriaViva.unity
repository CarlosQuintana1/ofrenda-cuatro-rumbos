  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MemoriaViva.WorldInteractable
  action: 1
  title: La Catrina
  description: "La Catrina naci\xF3 como La Calavera Garbancera, figura del grabador
    Jos\xE9 Guadalupe Posada, que la us\xF3 para burlarse de quienes aparentaban
    lo que no eran. El muralista Diego Rivera la rebautiz\xF3 como La Catrina. Recuerda
    que ante la muerte todos somos iguales. (Fuente: Wikipedia en espa\xF1ol)"
  verb: 
  offeringIndex: -1
  destination: {x: 0, y: 0, z: 0}
